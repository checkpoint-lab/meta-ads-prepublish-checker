{
  "manifest_version": 3,
  "name": "Meta広告 公開前チェッカー（非公式）",
  "version": "0.1.0",
  "description": "Meta広告マネージャの広告作成画面で、自動調整系の設定（エンハンス、翻訳など）がONになっていないかを、公開前に確認する補助ツール。非公式です。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/*"
      ],
      "js": [
        "rules.js",
        "scanner.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
